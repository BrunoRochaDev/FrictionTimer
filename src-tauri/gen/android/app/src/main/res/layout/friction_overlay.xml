<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/friction_overlay_scrim"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/friction_overlay_panel"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="28dp">

        <TextView
            android:id="@+id/friction_overlay_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/friction_overlay_message"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/friction_overlay_cancel"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:background="@drawable/friction_overlay_secondary_button"
                android:backgroundTint="@null"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:text="@string/friction_overlay_cancel"
                android:textAllCaps="false"
                android:textColor="@color/friction_overlay_secondary_text"
                android:textSize="20sp" />

            <Button
                android:id="@+id/friction_overlay_proceed"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/friction_overlay_primary_button"
                android:backgroundTint="@null"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:textAllCaps="false"
                android:textColor="@color/friction_overlay_primary_text"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
